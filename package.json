{
  "name": "art-saver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm -w @art/server run dev",
    "dev:client": "npm -w @art/client run dev",
    "build": "npm -w @art/client run build",
    "start": "npm -w @art/server run start",
    "test": "npm -w @art/server run test",
    "typecheck": "npm -w @art/server run typecheck && npm -w @art/client run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}